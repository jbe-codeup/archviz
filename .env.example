# Copy to .env (gitignored) and fill in values only if you need them.
# Every variable is optional; Archviz runs with none of them set.
# Loaded by `pnpm runner` / archviz-runner (also reads sibling ../archviz-enterprise/.env).
# Never commit a real .env; .gitignore excludes .env and .env.* except this file.

# --- LocalStack (local apply) -------------------------------------------------
# Default image is localstack/localstack:4.14.0, which needs no token.
# To use a current / trial LocalStack image instead, uncomment both lines and
# paste your own token (it starts with "ls-"):
# LOCALSTACK_IMAGE=localstack/localstack:latest
# LOCALSTACK_AUTH_TOKEN=ls-your-token-here
# LOCALSTACK_ENDPOINT=http://127.0.0.1:4566

# Docker socket the runner mounts into LocalStack (default /var/run/docker.sock)
# DOCKER_SOCK=/var/run/docker.sock

# --- MCP server ------------------------------------------------------------------
# Where @archviz/mcp stores diagrams (default ./projects, gitignored)
# ARCHVIZ_PROJECTS_DIR=./projects
